# Environment variables for ResolveLoop
# Copy this file to .env and fill in your keys. Never commit .env!

# OpenAI API Key for ResolveLoop runtime agents (Router, L1-L4, Evaluator, Reflection)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Model identifier for OpenAI runtime agents
RESOLVELOOP_MODEL=gpt-5-nano

# Enable OpenAI LLM calls (1 = enabled, 0 = heuristic mock fallback)
RESOLVELOOP_USE_LLM=0

# Smallest AI API Key for Voice Layer (Pulse STT & Lightning TTS)
SMALLEST_API_KEY=YOUR_SMALLEST_API_KEY
