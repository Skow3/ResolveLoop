# ResolveLoop Environment Variables
# Copy this file to .env and configure your keys:
# cp .env.example .env

# OpenAI API Key for ResolveLoop runtime agents (Router, L1-L4, Evaluator, Reflection)
OPENAI_API_KEY=your_openai_api_key_here

# Model identifier for OpenAI runtime agents (default: gpt-5-nano)
RESOLVELOOP_MODEL=gpt-5-nano

# Enable OpenAI LLM calls (1 = enabled, 0 = heuristic mock fallback)
RESOLVELOOP_USE_LLM=1

# Smallest AI API Key for Voice Layer (Pulse STT & Lightning TTS)
SMALLEST_API_KEY=your_smallest_ai_api_key_here
SMALLEST_PULSE_URL=https://waves-api.smallest.ai/api/v1/pulse/get_text
SMALLEST_LIGHTNING_URL=https://api.smallest.ai/waves/v1/lightning-v3.1/get_speech

# PostgreSQL Database URL for Maximor Finance
DATABASE_URL=postgresql:///maximor_finance

# Execution timeout in seconds
RESOLVELOOP_TIMEOUT=60
